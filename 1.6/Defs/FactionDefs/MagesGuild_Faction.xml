<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <FactionDef ParentName="FactionBase">
        <defName>ESCP_Faction_MagesGuild</defName>
        <label>Mages Guild</label>
        <description>The Mages Guild is a continent-spanning organization that controls the study, practice, and trade of the arcane arts. It maintains research halls, trains apprentices, and keeps a careful record of every notable spell, artefact, and magical phenomenon catalogd within its vast archives. Members are expected to follow the Guild's Code of Conduct: no traffic in necromancy, no unlicensed enchanting for civilians, and full disclosure of major discoveries. What happens in practice depends on the archmage in charge at a given hall. The Guild's neutrality is formal rather than absolute, but they generally prefer their researchers survive long enough to finish their work.</description>
        <colorSpectrum>
            <li>(0.38, 0.42, 0.82)</li>
        </colorSpectrum>
        <pawnSingular>guild mage</pawnSingular>
        <pawnsPlural>guild mages</pawnsPlural>
        <categoryTag>Outlander</categoryTag>
        <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
        <hidden>true</hidden>
        <settlementGenerationWeight>0</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <displayInFactionSelection>false</displayInFactionSelection>
        <canSiege>false</canSiege>
        <canStageAttacks>false</canStageAttacks>
        <leaderTitle>Archmage</leaderTitle>
        <factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath>
        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
        <techLevel>Medieval</techLevel>
        <fixedName>Mages Guild</fixedName>

        <backstoryFilters>
            <li>
                <categories>
                    <li>ESCP_Backstory_MagesGuild_Child</li>
                    <li>ESCP_Backstory_MagesGuild_Scholar</li>
                </categories>
                <commonality>0.8</commonality>
            </li>
        </backstoryFilters>

        <caravanTraderKinds>
            <li>ESCP_Caravan_MagesGuild_Arcanist</li>
        </caravanTraderKinds>

        <visitorTraderKinds>
            <li>ESCP_Caravan_MagesGuild_Arcanist</li>
        </visitorTraderKinds>

        <pawnGroupMakers>

            <li>
                <kindDef>Settlement</kindDef>
                <commonality>100</commonality>
                <options>
                    <ESCP_Pawnkind_MagesGuild_Apprentice>3</ESCP_Pawnkind_MagesGuild_Apprentice>
                    <ESCP_Pawnkind_MagesGuild_Wizard>2</ESCP_Pawnkind_MagesGuild_Wizard>
                    <ESCP_Pawnkind_MagesGuild_Warlock>1</ESCP_Pawnkind_MagesGuild_Warlock>
                </options>
            </li>

            <li>
                <kindDef>Peaceful</kindDef>
                <commonality>40</commonality>
                <options>
                    <ESCP_Pawnkind_MagesGuild_Apprentice>2</ESCP_Pawnkind_MagesGuild_Apprentice>
                    <ESCP_Pawnkind_MagesGuild_Wizard>1</ESCP_Pawnkind_MagesGuild_Wizard>
                </options>
            </li>

            <li>
                <kindDef>Trader</kindDef>
                <commonality>60</commonality>
                <options>
                    <ESCP_Pawnkind_MagesGuild_Apprentice>1</ESCP_Pawnkind_MagesGuild_Apprentice>
                </options>
                <traders>
                    <ESCP_Pawnkind_MagesGuild_Arcanist>1</ESCP_Pawnkind_MagesGuild_Arcanist>
                </traders>
                <carriers>
                    <Muffalo>4</Muffalo>
                    <Dromedary>2</Dromedary>
                </carriers>
            </li>

        </pawnGroupMakers>

        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0, 35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>
        <raidLootValueFromPointsCurve>
            <points>
                <li>(0, 0)</li>
                <li>(100, 20)</li>
                <li>(1000, 75)</li>
                <li>(3000, 100)</li>
            </points>
        </raidLootValueFromPointsCurve>

        <modExtensions Inherit="False">
            <li Class="ESCP_RaceTools.FactionProperties">
                <factionTags>
                    <li>ESCP_OpposesNecromancy</li>
                </factionTags>
            </li>
            <li Class="ESCP.Factions.FactionExtension_BannedArrivalModes">
                <arrivalModes>
                    <li>EdgeDrop</li>
                    <li>EdgeDropGroups</li>
                    <li>CenterDrop</li>
                    <li>RandomDrop</li>
                </arrivalModes>
            </li>
        </modExtensions>

    </FactionDef>

</Defs>
