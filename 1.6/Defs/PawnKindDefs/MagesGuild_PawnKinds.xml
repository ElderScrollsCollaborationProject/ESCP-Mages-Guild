<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <PawnKindDef Name="ESCP_MagesGuildkindBase" Abstract="True">
        <race>Human</race>
        <defaultFactionDef>ESCP_Faction_MagesGuild</defaultFactionDef>
        <useFactionXenotypes>true</useFactionXenotypes>
        <maxGenerationAge>70</maxGenerationAge>
        <minGenerationAge>18</minGenerationAge>
        <chemicalAddictionChance>0.02</chemicalAddictionChance>
        <invNutrition>2.7</invNutrition>
        <invFoodDef>MealSurvivalPack</invFoodDef>
        <disallowedTraits>
            <li>Nudist</li>
        </disallowedTraits>
        <pawnGroupDevelopmentStage>Adult</pawnGroupDevelopmentStage>
    </PawnKindDef>

    <PawnKindDef ParentName="ESCP_MagesGuildkindBase">
        <defName>ESCP_Pawnkind_MagesGuild_Apprentice</defName>
        <label>guild apprentice</label>
        <combatPower>35</combatPower>
        <itemQuality>Normal</itemQuality>
        <gearHealthRange>0.6~1.5</gearHealthRange>
        <weaponMoney>100~350</weaponMoney>
        <weaponTags>
            <li>SomeMelee</li>
        </weaponTags>
        <apparelMoney>250~550</apparelMoney>
        <techHediffsChance>0</techHediffsChance>
        <initialWillRange>1~3</initialWillRange>
        <initialResistanceRange>6~12</initialResistanceRange>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>ESCP_Backstory_MagesGuild_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>ESCP_Backstory_MagesGuild_Scholar</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
        <modExtensions>
            <li Class="ESCP.Core.Magic.PawnKindExtension_Spellcaster">
                <spells>
                    <li>ESCP_Spell_Firebolt</li>
                </spells>
                <randomSpells>
                    <li>ESCP_Spell_Healing</li>
                    <li>ESCP_Spell_Ward</li>
                </randomSpells>
                <randomCount>1~1</randomCount>
            </li>
        </modExtensions>
    </PawnKindDef>

    <PawnKindDef ParentName="ESCP_MagesGuildkindBase">
        <defName>ESCP_Pawnkind_MagesGuild_Wizard</defName>
        <label>guild wizard</label>
        <combatPower>55</combatPower>
        <minGenerationAge>25</minGenerationAge>
        <itemQuality>Good</itemQuality>
        <gearHealthRange>0.7~1.8</gearHealthRange>
        <weaponMoney>200~500</weaponMoney>
        <weaponTags>
            <li>SomeMelee</li>
        </weaponTags>
        <apparelMoney>500~1000</apparelMoney>
        <techHediffsMoney>100~100</techHediffsMoney>
        <techHediffsTags>
            <li>Middle</li>
        </techHediffsTags>
        <techHediffsChance>0.15</techHediffsChance>
        <initialWillRange>2~5</initialWillRange>
        <initialResistanceRange>8~16</initialResistanceRange>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>ESCP_Backstory_MagesGuild_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>ESCP_Backstory_MagesGuild_Scholar</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
        <modExtensions>
            <li Class="ESCP.Core.Magic.PawnKindExtension_Spellcaster">
                <spells>
                    <li>ESCP_Spell_Firebolt</li>
                    <li>ESCP_Spell_Ward</li>
                </spells>
                <randomSpells>
                    <li>ESCP_Spell_IceSpike</li>
                    <li>ESCP_Spell_Healing</li>
                    <li>ESCP_Spell_Oakflesh</li>
                </randomSpells>
                <randomCount>1~1</randomCount>
            </li>
        </modExtensions>
    </PawnKindDef>

    <PawnKindDef ParentName="ESCP_MagesGuildkindBase">
        <defName>ESCP_Pawnkind_MagesGuild_Warlock</defName>
        <label>guild warlock</label>
        <combatPower>75</combatPower>
        <minGenerationAge>35</minGenerationAge>
        <itemQuality>Excellent</itemQuality>
        <gearHealthRange>0.8~2.0</gearHealthRange>
        <weaponMoney>300~700</weaponMoney>
        <weaponTags>
            <li>GoodMelee</li>
        </weaponTags>
        <apparelMoney>800~1500</apparelMoney>
        <techHediffsMoney>150~150</techHediffsMoney>
        <techHediffsTags>
            <li>Middle</li>
            <li>Rich</li>
        </techHediffsTags>
        <techHediffsChance>0.25</techHediffsChance>
        <initialWillRange>4~8</initialWillRange>
        <initialResistanceRange>12~22</initialResistanceRange>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>ESCP_Backstory_MagesGuild_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>ESCP_Backstory_MagesGuild_Scholar</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
        <modExtensions>
            <li Class="ESCP.Core.Magic.PawnKindExtension_Spellcaster">
                <spells>
                    <li>ESCP_Spell_Fireball</li>
                    <li>ESCP_Spell_ConjureWolf</li>
                </spells>
                <randomSpells>
                    <li>ESCP_Spell_Fear</li>
                    <li>ESCP_Spell_SoulTrap</li>
                    <li>ESCP_Spell_ConjureSpider</li>
                </randomSpells>
                <randomCount>1~1</randomCount>
            </li>
        </modExtensions>
    </PawnKindDef>

    <PawnKindDef ParentName="ESCP_MagesGuildkindBase">
        <defName>ESCP_Pawnkind_MagesGuild_Arcanist</defName>
        <label>guild arcanist</label>
        <combatPower>40</combatPower>
        <trader>true</trader>
        <itemQuality>Normal</itemQuality>
        <gearHealthRange>0.6~1.5</gearHealthRange>
        <weaponMoney>150~350</weaponMoney>
        <weaponTags>
            <li>SomeMelee</li>
        </weaponTags>
        <apparelMoney>400~800</apparelMoney>
        <techHediffsChance>0</techHediffsChance>
        <initialWillRange>1~3</initialWillRange>
        <initialResistanceRange>6~12</initialResistanceRange>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>ESCP_Backstory_MagesGuild_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>ESCP_Backstory_MagesGuild_Scholar</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
        <modExtensions>
            <li Class="ESCP.Core.Magic.PawnKindExtension_Spellcaster">
                <spells>
                    <li>ESCP_Spell_IceSpike</li>
                    <li>ESCP_Spell_Ward</li>
                    <li>ESCP_Spell_Telekinesis</li>
                </spells>
                <randomSpells>
                    <li>ESCP_Spell_Fireball</li>
                    <li>ESCP_Spell_Paralyze</li>
                </randomSpells>
                <randomCount>1~1</randomCount>
            </li>
        </modExtensions>
    </PawnKindDef>

</Defs>
